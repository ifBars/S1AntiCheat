root = true

[*.cs]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{csproj,props,slnx,md,ps1}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
